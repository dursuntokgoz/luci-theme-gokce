{#
 Copyright 2026 Dursun Tokgöz - https://www.dursuntokgoz.com.tr/
 Licensed under the Gökçe Theme License v1.0 (see LICENSE at the repo root).

 Structurally based on themes/luci-theme-bootstrap/ucode/template/themes/bootstrap/header.ut
 (LuCI project, Apache-2.0; see NOTICE) - replaces the top dropdown nav with a collapsible
 left sidebar; #tabmenu / #modemenu / #indicators keep their original meaning
 and DOM ids so core and third-party luci-app-* JS keeps working unmodified.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const darkpref = (theme == 'gokce-dark' ? 'true' : (theme == 'gokce-light' ? 'false' : null));

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" {{ darkpref ? `data-darkmode="${darkpref}"` : '' }}>
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<script>
			/* Pre-paint appearance: apply saved dark-mode / accent / density
			   before the stylesheet loads so there is no flash of unstyled or
			   wrong-themed content (FOUC). Guarded try/catch: private mode or
			   disabled storage must never break rendering. */
			(function () {
				var root = document.documentElement;
				var forcedDark = {{ darkpref !== null ? (darkpref === 'true' ? 'true' : 'false') : 'null' }};

				function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }

				/* Dark mode: forced by GokceDark/GokceLight, else stored override, else OS pref */
				if (forcedDark === null) {
					var stored = get('gokce-darkmode');
					if (stored !== null) {
						root.setAttribute('data-darkmode', stored === 'true' ? 'true' : 'false');
					} else {
						var mq = window.matchMedia('(prefers-color-scheme: dark)');
						root.setAttribute('data-darkmode', mq.matches ? 'true' : 'false');
						mq.addEventListener('change', function (e) {
							if (get('gokce-darkmode') === null)
								root.setAttribute('data-darkmode', e.matches ? 'true' : 'false');
						});
					}
				}

				var accent = get('gokce-accent');
				if (accent) root.setAttribute('data-accent', accent);

				var density = get('gokce-density');
				if (density) root.setAttribute('data-density', density);
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="icon" href="/luci-static/gokce/logo.svg" sizes="any">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">

		<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
			<symbol id="gokce-icon-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></symbol>
			<symbol id="gokce-icon-dashboard" viewBox="0 0 24 24"><path d="M4 13h6V4H4v9zm0 7h6v-5H4v5zm10 0h6v-9h-6v9zm0-16v5h6V4h-6z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-settings" viewBox="0 0 24 24"><path d="M12 15.5A3.5 3.5 0 1112 8.5a3.5 3.5 0 010 7zm7.4-2.6c.05-.3.1-.6.1-.9s-.05-.6-.1-.9l2-1.6a.5.5 0 00.1-.6l-1.9-3.3a.5.5 0 00-.6-.2l-2.4 1a7 7 0 00-1.6-.9l-.4-2.6a.5.5 0 00-.5-.4h-3.8a.5.5 0 00-.5.4l-.4 2.6a7 7 0 00-1.6.9l-2.4-1a.5.5 0 00-.6.2L2.9 8.9a.5.5 0 00.1.6l2 1.6c-.05.3-.1.6-.1.9s.05.6.1.9l-2 1.6a.5.5 0 00-.1.6l1.9 3.3c.1.2.4.3.6.2l2.4-1c.5.4 1 .7 1.6.9l.4 2.6c0 .2.2.4.5.4h3.8c.3 0 .5-.2.5-.4l.4-2.6a7 7 0 001.6-.9l2.4 1c.2.1.5 0 .6-.2l1.9-3.3a.5.5 0 00-.1-.6l-2-1.6z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-globe" viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 2c1.9 0 3.6 2.9 3.9 7H8.1c.3-4.1 2-7 3.9-7zm-5.9 7H4.1a8 8 0 014.6-6.3A13.6 13.6 0 006.1 11zm0 2a13.6 13.6 0 002.6 6.3A8 8 0 014.1 13h2zm2 0h7.8c-.3 4.1-2 7-3.9 7s-3.6-2.9-3.9-7zm9.8 0h2a8 8 0 01-4.6 6.3 13.6 13.6 0 002.6-6.3zm0-2a13.6 13.6 0 00-2.6-6.3A8 8 0 0119.9 11h-2z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-layers" viewBox="0 0 24 24"><path d="M12 2l9 5-9 5-9-5 9-5zm-9 8.5L12 15l9-4.5v3L12 18l-9-4.5v-3zm0 5L12 20l9-4.5v3L12 23l-9-4.5v-3z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-shield" viewBox="0 0 24 24"><path d="M12 2l8 3v6c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5l8-3zm-1 13.5l6-6-1.4-1.4L11 12.7 9.4 11 8 12.4l3 3.1z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-dot" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5" fill="currentColor"/><path d="M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
			<symbol id="gokce-icon-moon" viewBox="0 0 24 24"><path d="M20.7 14.9A8.8 8.8 0 019.1 3.3 9 9 0 1020.7 15z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-chevron" viewBox="0 0 24 24"><path d="M8.6 9l3.4 3.4L15.4 9 17 10.6l-5 5-5-5L8.6 9z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-palette" viewBox="0 0 24 24"><path d="M12 3a9 9 0 000 18c.8 0 1.5-.7 1.5-1.5 0-.4-.2-.8-.4-1-.3-.3-.4-.6-.4-1 0-.8.7-1.5 1.5-1.5H15a6 6 0 006-6c0-3.9-4-7-9-7zm-5.5 9a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm3-4a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm5 0a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm3.5 4a1.5 1.5 0 110-3 1.5 1.5 0 010 3z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-check" viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5L4 14.2l5 5 11-11-1.5-1.5z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-auto" viewBox="0 0 24 24"><path d="M12 3a9 9 0 000 18V3z" fill="currentColor"/><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/></symbol>
			<symbol id="gokce-icon-search" viewBox="0 0 24 24"><path d="M10 4a6 6 0 104.2 10.3l4.8 4.7 1.4-1.4-4.7-4.8A6 6 0 0010 4zm0 2a4 4 0 110 8 4 4 0 010-8z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-star" viewBox="0 0 24 24"><path d="M12 4.5l2.1 4.6 5 .5-3.8 3.4 1.1 4.9L12 15.9l-4.4 2.5 1.1-4.9L4.9 9.6l5-.5L12 4.5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></symbol>
			<symbol id="gokce-icon-star-fill" viewBox="0 0 24 24"><path d="M12 3.6l2.5 5.4 5.9.6-4.4 4 1.3 5.8L12 16.4 6.7 19.4l1.3-5.8-4.4-4 5.9-.6L12 3.6z" fill="currentColor"/></symbol>
			<symbol id="gokce-icon-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
		</svg>

		{% if (!blank_page): %}
		<div class="app" id="gokce-app">
			<aside class="sidebar" id="gokce-sidebar">
				<div class="sidebar__brand">
					<a class="sidebar__brand-link" href="/">
						<img class="sidebar__logo" src="/luci-static/gokce/logo.svg" alt="">
						<span class="sidebar__brand-text">{{ striptags(boardinfo.hostname ?? '?') }}</span>
					</a>
				</div>
				<nav class="sidebar__nav" id="sidebar-menu"></nav>
			</aside>

			<div class="overlay" id="gokce-overlay"></div>

			<div class="gokce-search" id="gokce-search" hidden>
				<div class="gokce-search__backdrop" data-search-close></div>
				<div class="gokce-search__box" role="dialog" aria-modal="true" aria-label="{{ _('Search pages') }}">
					<div class="gokce-search__field">
						<svg class="icon gokce-search__icon"><use href="#gokce-icon-search"/></svg>
						<input type="text" id="gokce-search-input" class="gokce-search__input" autocomplete="off" spellcheck="false" placeholder="{{ _('Search pages…') }}" aria-label="{{ _('Search pages') }}">
						<kbd class="gokce-search__kbd">Esc</kbd>
					</div>
					<ul class="gokce-search__results" id="gokce-search-results" role="listbox"></ul>
				</div>
			</div>

			<div class="main">
				<header class="header">
					<div class="header__left">
						<button class="header__btn" id="gokce-sidebar-toggle" type="button" aria-label="{{ _('Toggle menu') }}">
							<svg class="icon"><use href="#gokce-icon-menu"/></svg>
						</button>
						<h1 class="header__title">{{ striptags(dispatched?.title ? _(dispatched.title) : (boardinfo.hostname ?? 'Gökçe')) }}</h1>
					</div>
					<div class="header__right">
						<button class="header__btn" id="gokce-search-toggle" type="button" aria-label="{{ _('Search pages') }}" title="{{ _('Search pages') }} (Ctrl+K)">
							<svg class="icon"><use href="#gokce-icon-search"/></svg>
						</button>
						<button class="header__btn header__btn--fav" id="gokce-fav-toggle" type="button" hidden aria-pressed="false" aria-label="{{ _('Add to favorites') }}">
							<svg class="icon header__fav-icon--off"><use href="#gokce-icon-star"/></svg>
							<svg class="icon header__fav-icon--on"><use href="#gokce-icon-star-fill"/></svg>
						</button>
						<div id="indicators" class="header__indicators"></div>
						{% if (!darkpref): %}
						<button class="header__btn" id="gokce-theme-toggle" type="button" aria-label="{{ _('Toggle dark mode') }}">
							<svg class="icon header__theme-icon--light"><use href="#gokce-icon-moon"/></svg>
							<svg class="icon header__theme-icon--dark"><use href="#gokce-icon-sun"/></svg>
						</button>
						{% endif %}

						<div class="appearance" id="gokce-appearance">
							<button class="header__btn" id="gokce-appearance-toggle" type="button"
								aria-haspopup="true" aria-expanded="false" aria-label="{{ _('Appearance') }}">
								<svg class="icon"><use href="#gokce-icon-palette"/></svg>
							</button>

							<div class="appearance__panel" id="gokce-appearance-panel" role="dialog" aria-label="{{ _('Appearance') }}" hidden>
								{% if (!darkpref): %}
								<div class="appearance__group">
									<span class="appearance__label">{{ _('Theme') }}</span>
									<div class="appearance__seg" id="gokce-mode-seg" role="group">
										<button type="button" class="appearance__seg-btn" data-mode="auto">
											<svg class="icon"><use href="#gokce-icon-auto"/></svg>{{ _('Auto') }}</button>
										<button type="button" class="appearance__seg-btn" data-mode="light">
											<svg class="icon"><use href="#gokce-icon-sun"/></svg>{{ _('Light') }}</button>
										<button type="button" class="appearance__seg-btn" data-mode="dark">
											<svg class="icon"><use href="#gokce-icon-moon"/></svg>{{ _('Dark') }}</button>
									</div>
								</div>
								{% endif %}

								<div class="appearance__group">
									<span class="appearance__label">{{ _('Accent') }}</span>
									<div class="appearance__accents" id="gokce-accent-list" role="group">
										<button type="button" class="appearance__accent" data-accent="blue"   style="--dot:#3b6ef5" aria-label="{{ _('Blue') }}"><svg class="icon"><use href="#gokce-icon-check"/></svg></button>
										<button type="button" class="appearance__accent" data-accent="indigo" style="--dot:#6366f1" aria-label="{{ _('Indigo') }}"><svg class="icon"><use href="#gokce-icon-check"/></svg></button>
										<button type="button" class="appearance__accent" data-accent="teal"   style="--dot:#0ea5a4" aria-label="{{ _('Teal') }}"><svg class="icon"><use href="#gokce-icon-check"/></svg></button>
										<button type="button" class="appearance__accent" data-accent="green"  style="--dot:#22a35e" aria-label="{{ _('Green') }}"><svg class="icon"><use href="#gokce-icon-check"/></svg></button>
										<button type="button" class="appearance__accent" data-accent="amber"  style="--dot:#f59e0b" aria-label="{{ _('Amber') }}"><svg class="icon"><use href="#gokce-icon-check"/></svg></button>
										<button type="button" class="appearance__accent" data-accent="rose"   style="--dot:#f43f5e" aria-label="{{ _('Rose') }}"><svg class="icon"><use href="#gokce-icon-check"/></svg></button>
										<button type="button" class="appearance__accent" data-accent="violet" style="--dot:#a855f7" aria-label="{{ _('Violet') }}"><svg class="icon"><use href="#gokce-icon-check"/></svg></button>
									</div>
								</div>

								<div class="appearance__group">
									<span class="appearance__label">{{ _('Density') }}</span>
									<div class="appearance__seg" id="gokce-density-seg" role="group">
										<button type="button" class="appearance__seg-btn" data-density="comfortable">{{ _('Comfortable') }}</button>
										<button type="button" class="appearance__seg-btn" data-density="compact">{{ _('Compact') }}</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</header>

				<div id="maincontent" class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
						<div class="alert-message warning">
							<h4>{{ _('No password set!') }}</h4>
							<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
							{% if (dispatcher.lookup("admin/system/admin")): %}
							  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					{% if (boardinfo.rootfs_type == "initramfs"): %}
						<div class="alert-message warning">
							<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
							<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
							{% if (dispatcher.lookup("admin/system/flash")): %}
							  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
		{% endif %}
